{
  "schemaVersion": 1,
  "id": "duskcut-win64-gpl-no-dvd-v1",
  "description": "Windows x64 static FFmpeg for DuskCut: local media editing, font/subtitle rendering, audio effects, CPU encoding and NVIDIA/Intel/AMD hardware encoding. No DVD access or CSS decryption.",
  "rootDependencies": ["libiconv", "zlib", "fribidi", "libxml2", "xz", "fonts", "libvorbis", "amf", "aom", "avisynth", "dav1d", "ffnvcodec", "gme", "libass", "libmp3lame", "libopus", "libtheora", "libvpx", "libwebp", "onevpl", "opencore-amr", "openjpeg", "openmpt", "rubberband", "schannel", "soxr", "svtav1", "vidstab", "x264", "x265", "xvid", "zimg"],
  "sourceStages": ["10-mingw-std-threads", "10-mingw", "20-libiconv", "20-zlib", "25-fftw3", "25-freetype", "25-fribidi", "25-libogg", "25-libxml2", "25-xz", "35-fontconfig", "45-harfbuzz", "45-libsamplerate", "45-libunibreak", "45-libvorbis", "45-vmaf", "50-amf", "50-aom", "50-avisynth", "50-dav1d", "50-ffnvcodec", "50-freetype", "50-gme", "50-libass", "50-libmp3lame", "50-libopus", "50-libtheora", "50-libvpx", "50-libwebp", "50-onevpl", "50-opencore-amr", "50-openjpeg", "50-openmpt", "50-rubberband", "50-soxr", "50-svtav1", "50-vidstab", "50-x264", "50-x265", "50-xvid", "50-zimg"],
  "forbiddenStagePatterns": ["dvd", "css", "rav1e", "rust", "rsvg", "jxl", "lcevc", "vulkan", "placebo", "whisper"],
  "configureFlags": ["--disable-autodetect", "--enable-static", "--disable-shared", "--disable-ffplay", "--disable-libdvdnav", "--disable-libdvdread", "--disable-libcdio", "--enable-amf", "--enable-cuda-llvm", "--enable-cuvid", "--enable-d3d11va", "--enable-d3d12va", "--enable-dxva2", "--enable-ffnvcodec", "--enable-nvdec", "--enable-nvenc", "--enable-mediafoundation"]
}
